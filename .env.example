# Copie para .env e preencha. O .env nunca vai para o Git.

# --- Modelos (formato "provedor:modelo") ---------------------------------------
# OpenAI (padrão)
CHAT_MODEL=openai:gpt-4.1-mini
EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=

# Alternativa com cota gratuita: Google Gemini (pip install -e ".[google]")
# CHAT_MODEL=google_genai:gemini-3.5-flash-lite
# EMBEDDING_MODEL=google_genai:models/gemini-embedding-001
# GOOGLE_API_KEY=
# A cota gratuita aceita poucas chamadas por minuto; o limitador evita erros 429:
# LLM_REQUESTS_PER_MINUTE=12

# Alternativa 100% local: Ollama (pip install -e ".[ollama]" e `ollama pull ...`)
# CHAT_MODEL=ollama:llama3.1
# EMBEDDING_MODEL=ollama:nomic-embed-text

# Sem chave nenhuma, só para testar a ingestão (busca por palavras, não semântica):
# EMBEDDING_MODEL=offline:hashing

# --- LangSmith -----------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-langgraph-supervisor
# Conta na região da UE? Descomente:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- RAG (opcionais) -------------------------------------------------------------
# DOCS_DIR=data/docs
# CHROMA_DIR=.chroma
# CHROMA_COLLECTION=docs
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=4
# MAX_STEPS=6
